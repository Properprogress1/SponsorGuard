# After `npm run db:start`, copy the values from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for validated document uploads and local browser fixtures.
SUPABASE_SERVICE_ROLE_KEY=

# Scheduled email digests. Use distinct, randomly generated secrets.
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_APP_ORIGIN=
NOTIFICATION_UNSUBSCRIBE_SECRET=

# Stripe prices must be GBP recurring prices matching the four advertised amounts.
BILLING_APP_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_CORE_MONTHLY_PRICE_ID=
STRIPE_CORE_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# Canonical public origin for SEO metadata, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Independent server-side secret for HMAC rate-limit keys. Generate at least 32 random bytes.
APP_RATE_LIMIT_SECRET=
# For non-Vercel hosting, opt in only if ingress overwrites X-Forwarded-For with one verified IP.
RATE_LIMIT_TRUST_PROXY=0
